        "jsCode": "// 1. CONFIGURACIÓN DE TIEMPO\nconst timezone = 'America/Argentina/Buenos_Aires';\nconst ahora = DateTime.now().setZone(timezone);\n\n// 2. EXTRACCIÓN DE DATOS\nconst input = $input.first().json;\n\n// Intentamos sacar el día de los parámetros de la IA o del texto\nlet textoParaAnalizar = input.dayRequested || input.text || \"hoy\";\nlet horaParaAnalizar = input.timeRequested || input.text || \"09:00\";\n\nlet diaDetectado = \"hoy\";\nlet horaDetectada = \"09:00\";\n\n// 3. BUSCADOR DE PALABRAS CLAVE\nconst dias = [\"lunes\", \"martes\", \"miercoles\", \"miércoles\", \"jueves\", \"viernes\", \"sabado\", \"sábado\", \"domingo\", \"manana\", \"mañana\"];\nconst lowerText = textoParaAnalizar.toString().toLowerCase();\n\nfor (let d of dias) {\n    if (lowerText.includes(d)) {\n        diaDetectado = d;\n        break;\n    }\n}\n\n// Buscador de hora\nconst horaMatch = lowerText.match(/(\\d{1,2})(?::(\\d{2}))?/);\nif (horaMatch) {\n    horaDetectada = `${horaMatch[1].padStart(2, '0')}:${horaMatch[2] || '00'}`;\n} else if (input.timeRequested) {\n    horaDetectada = input.timeRequested;\n}\n\n// 4. MAPEO DE DÍAS Y CÁLCULO\nconst mapaDias = {\n    \"lunes\": 1, \"martes\": 2, \"miercoles\": 3, \"miércoles\": 3,\n    \"jueves\": 4, \"viernes\": 5, \"sabado\": 6, \"sábado\": 6, \"domingo\": 7\n};\n\nlet diasASumar = 0;\nlet diaLimpio = diaDetectado.normalize(\"NFD\").replace(/[\\u0300-\\u036f]/g, \"\");\n\nif (diaLimpio === \"manana\") {\n    diasASumar = 1;\n} else if (mapaDias[diaLimpio]) {\n    const numDiaDestino = mapaDias[diaLimpio];\n    const numDiaActual = ahora.weekday;\n    diasASumar = numDiaDestino - numDiaActual;\n    if (diasASumar <= 0) diasASumar += 7;\n}\n\n// 5. CÁLCULO DE FECHA FINAL (Aquí se define la variable)\nlet fechaFinal = ahora.plus({ days: diasASumar });\nconst [h, m] = horaDetectada.split(':').map(Number);\nfechaFinal = fechaFinal.set({ hour: h, minute: m, second: 0, millisecond: 0 });\n\n// 6. RESPUESTA PARA EL AGENTE (MODO REVISIÓN)\nconst nombreDiaFinal = fechaFinal.setLocale('es-AR').toFormat('EEEE');\nconst fechaLegible = fechaFinal.setLocale('es-AR').toFormat(\"d 'de' MMMM\");\n\nconst respuesta = {\n    fecha_calculada: fechaFinal.toFormat('yyyy-MM-dd'),\n    dia_nombre: nombreDiaFinal,\n    // Mensaje técnico para que el agente entienda pero no confirme aún\n    confirmacion: `ANÁLISIS TÉCNICO: El usuario se refiere al día ${nombreDiaFinal} ${fechaLegible}. Valida disponibilidad en el calendario para esta fecha.`,\n    startIso: fechaFinal.toISO(),\n    endIso: fechaFinal.plus({ hours: 1 }).toISO(),\n    debug: `Detectado: ${diaDetectado} | Suma: ${diasASumar}`\n};\n\nreturn JSON.stringify(respuesta);",
